# ===== Configuración del servidor proxy (Hostinger) =====
# Copiar este archivo a `.env` y completar los valores.
# NUNCA versionar este archivo (`.env` ya está en .gitignore).

PORT=3000

# URL de tu sitio WooCommerce (sin barra final)
WC_URL=https://pedidospaul.agudev.com.ar

# Claves de la REST API de WooCommerce (permiso Read/Write).
# Estas claves se quedan SOLO en el servidor. Rotarlas en WooCommerce
# > Ajustes > Avanzado > API REST si alguna vez se expusieron al cliente.
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxx

# Secreto para firmar los tokens de la app.
# Generar uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=poner-un-secreto-largo-y-aleatorio

# Orígenes permitidos para CORS, separados por coma (sin barra final).
# Agregar tu dominio del frontend en producción.
CORS_ORIGIN=http://localhost:5173,https://tu-frontend.com.ar

# Endpoint jwt-auth del sitio (requiere plugin "JWT Authentication for WP REST API").
# Este endpoint valida usuario/contraseña contra WordPress.
JWT_TOKEN_URL=https://pedidospaul.agudev.com.ar/wp-json/jwt-auth/v1/token

# TTL del caché de productos/clientes (segundos).
CACHE_TTL=60

# ===== Base de datos MySQL (Hostinger) =====
# Se usa cuando DATA_SOURCE=mysql. Si DB_HOST no está, el proxy sigue con WooCommerce.
DB_HOST=localhost
DB_PORT=3306
DB_USER=usuario_mysql
DB_PASSWORD=clave_mysql
DB_NAME=nombre_bd

# Origen de datos de la app: woocommerce (default) | mysql
DATA_SOURCE=woocommerce

# Credenciales del admin para la migracion (solo se usan en `npm run migrate`)
ADMIN_USERNAME=tu_usuario_admin
ADMIN_PASSWORD=tu_password_nueva

